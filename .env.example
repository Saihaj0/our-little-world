# ---------------------------------------------------------------------------
# Our Little World — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# The password that unlocks the website. Use a long, memorable phrase
# (a sentence works well). Minimum 8 characters — the app refuses shorter ones.
SITE_PASSWORD=change-me-to-a-real-password

# Secret key used to sign session cookies (HTTP-only, tamper-proof).
# Generate a strong random value — see the README for one-liners.
# Minimum 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters
